# ── Conexión Supabase (Frontend) ──
# Obtené estos datos en tu proyecto Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://TU-PROYECTO-BASQUET.supabase.co
VITE_SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY

# URL pública del logo subido a Supabase Storage (opcional)
VITE_CLUB_LOGO_URL=https://TU-PROYECTO-BASQUET.supabase.co/storage/v1/object/public/assets/logo.png

# ── Fechas Oficiales de cada Cena (Opcionales, tienen valores por defecto) ──
VITE_EVENT_DATE_MASCULINO="Viernes 18 de Diciembre de 2026 (18/12) · 21:00 hs"
VITE_EVENT_DATE_FEMENINO="Sábado 19 de Diciembre de 2026 (19/12) · 21:00 hs"

# ── Datos de Cobro por Transferencia Oficial Básquet ──
# Alias oficial para transferencias
VITE_CLUB_ALIAS=basquet.atsc
VITE_CLUB_TITULAR=Subcomisión de Básquet ATSC
VITE_CLUB_BANCO=Banco Nación / Billetera Virtual

# Teléfono de WhatsApp para recibir comprobantes (código país + área + número sin espacios ni guiones)
VITE_WHATSAPP_PHONE=5492615751033

# ── Configuración SMTP Nodemailer (Gmail con Contraseña de Aplicación) ──
# Servidor SMTP (por defecto smtp.gmail.com si no se especifica)
SMTP_HOST=smtp.gmail.com

# Puerto SMTP (por defecto 465)
SMTP_PORT=465

# Seguridad SSL/TLS: true para puerto 465, false para 587 con STARTTLS
SMTP_SECURE=true

# Correo de Gmail desde donde se envían las entradas
SMTP_USER=tu-correo@gmail.com

# Contraseña de aplicación de 16 caracteres de Google (NO tu contraseña personal de Gmail)
# Generala en: https://myaccount.google.com/apppasswords
SMTP_PASS=abcd efgh ijkl mnop

# Remitente visible en el correo
MAIL_FROM=Andes Talleres Básquet <tu-correo@gmail.com>
