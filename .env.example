# ── Conexión Supabase (Frontend) ──
# Obtené estos datos en tu proyecto Supabase -> Project Settings -> API
VITE_SUPABASE_URL=https://TU-PROYECTO-BASQUET.supabase.co
VITE_SUPABASE_ANON_KEY=TU_SUPABASE_ANON_KEY

# URL pública del logo subido a Supabase Storage (opcional)
VITE_CLUB_LOGO_URL=

# ── Datos Oficiales del Evento ──
VITE_EVENT_DATE="Lunes 14 de Diciembre de 2026 (14/12) · 20:00 hs"
VITE_EVENT_VENUE="Camping del Club Andes Talleres"

# ── Contraseñas de Acceso al Panel de Control / Escáner ──
VITE_ADMIN_PASSWORD=cenabasquet2026
VITE_STAFF_PASSWORD=puerta2026

# ── Datos de Cobro por Transferencia Oficial Básquet ──
VITE_CLUB_ALIAS=atsc.basquet.fem
VITE_CLUB_TITULAR=LAURA CAROLINA BAY
VITE_CLUB_BANCO=Naranja X

# Teléfono de WhatsApp para recibir comprobantes (código país + área + número sin espacios ni guiones)
VITE_WHATSAPP_PHONE=5492616133159

# ── Configuración SMTP Nodemailer (Gmail con Contraseña de Aplicación) ──
# Servidor SMTP (por defecto smtp.gmail.com si no se especifica)
SMTP_HOST=smtp.gmail.com

# Puerto SMTP (por defecto 465)
SMTP_PORT=465

# Seguridad SSL/TLS: true para puerto 465
SMTP_SECURE=true

# Correo de Gmail desde donde se envían las entradas
SMTP_USER=basquet.fem.atsc.23@gmail.com

# Contraseña de aplicación de 16 caracteres de Google (se genera en https://myaccount.google.com/apppasswords)
SMTP_PASS=tu_codigo_de_16_letras

# Remitente visible en el correo
MAIL_FROM=Andes Talleres Básquet Femenino <basquet.fem.atsc.23@gmail.com>
